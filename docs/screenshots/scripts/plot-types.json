    { "op": "action", "action": "plot.type.bar" },        { "op": "settle", "ms": 300 }, { "op": "shot", "out": "plot-bar.png" },
    { "op": "action", "action": "plot.type.histogram" },  { "op": "settle", "ms": 300 }, { "op": "shot", "out": "plot-histogram.png" },
    { "op": "action", "action": "plot.type.fft" },        { "op": "settle", "ms": 300 }, { "op": "shot", "out": "plot-fft.png" },
    { "op": "action", "action": "plot.type.gauge" },      { "op": "settle", "ms": 300 }, { "op": "shot", "out": "plot-gauge.png" }
