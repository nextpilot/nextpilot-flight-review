#!/usr/bin/env sh
# 提交前：格式化暂存区 + 整文件重排告警。
#   - C/C++     只格式变更行（clang-format，见仓库根 .clang-format 头注释）
#   - Markdown  prettier
#   - Python    ruff（format + check --fix）
#
# 每个 clone 启用一次：
#   git config core.hooksPath .githooks
#
# 跳过（不建议；CI 门禁仍会拦）：
#   git commit --no-verify
#
# 本 hook 不阻断提交：格式化只修不拦，工具缺失时打印提示后放行。
# 唯一会打印告警的是"疑似整文件重排"——告警后仍放行，但推之前必须处理
# （见 docs/develop/push-gate.md 的三条硬禁令）。
# 真正阻断推送的是 pre-push（调 tools/ci/local_preflight.sh）。
#
# 具体逻辑在 tools/format.sh，避免 hook 与 CI 各写一套规则。

set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "$ROOT/tools/format.sh" ] || exit 0

(cd "$ROOT" && tools/format.sh --staged) || true

# 整文件重排告警：暂存区的 C/C++ 改动行数与忽略空白后的行数差得离谱时提示。
# 阈值与 tools/ci/local_preflight.sh 一致（>200 行且 >3 倍）。
cd "$ROOT" || exit 0
for f in $(git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.h' '*.hpp'); do
    A=$(git diff --cached --numstat -- "$f" | awk '{print $1+0}')
    W=$(git diff --cached -w --numstat -- "$f" | awk '{print $1+0}')
    if [ "${A:-0}" -gt 200 ] && [ "${A:-0}" -gt $((3 * (${W:-0} + 1))) ]; then
        printf '[pre-commit] 疑似整文件重排：%s（改动行 %s / 忽略空白 %s）\n' "$f" "$A" "$W"
        printf '  按 docs/develop/push-gate.md 拆成独立 style 提交，或回退格式改动。\n'
    fi
done

exit 0
