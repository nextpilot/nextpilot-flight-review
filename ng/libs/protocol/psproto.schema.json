{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotscope.local/schema/psproto-2.json",
  "title": "psproto v2 帧协议模板",
  "description": "顺序字节流 → 帧 → 字段的描述语言。规范见 SPEC.md；本文件只做结构层校验（键、类型、枚举、必填/互斥），语义校验由 C++ validate() 承担。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "mode",
    "segments"
  ],
  "properties": {
    "psproto": {
      "type": "string",
      "const": "2",
      "description": "版本键；v1 键已删除，不做兼容映射"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["bin", "text"],
      "description": "处理形态：bin 按字节解释；text 按字符串切 token 再解析。必填，不设 mixed"
    },
    "description": {
      "type": "string"
    },
    "layout": {
      "type": "string",
      "enum": [
        "sequential"
      ],
      "default": "sequential"
    },
    "endian": {
      "type": "string",
      "enum": [
        "little",
        "big",
        "le",
        "be"
      ],
      "default": "little"
    },
    "maxsize": {
      "type": "integer",
      "minimum": 2,
      "maximum": 65535,
      "default": 4096
    },
    "terminator": {
      "type": "string",
      "description": "text 帧终止标记（可选）"
    },
    "segments": {
      "$ref": "#/$defs/segmentArray"
    },
    "series": {
      "$ref": "#/$defs/series"
    },
    "types": {
      "type": "object",
      "description": "类型别名（对应 DBC SGTYPE）：别名 → 复用的 type/scale/unit/range",
      "additionalProperties": {
        "$ref": "#/$defs/typeAlias"
      }
    },
    "timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "term": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "帧尾候选集；写了就硬校验，没写就不检查"
    }
  },
  "$defs": {
    "typeName": {
      "type": "string",
      "enum": [
        "u8",
        "i8",
        "u16",
        "i16",
        "u32",
        "i32",
        "u64",
        "i64",
        "f32",
        "f64",
        "bool",
        "bcd",
        "char",
        "string",
        "str",
        "number",
        "num",
        "rest",
        "time"
      ]
    },
    "expr": {
      "type": "string",
      "description": "表达式，引用前序段名"
    },
    "segmentArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "typeAlias": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "bit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "width"
      ],
      "properties": {
        "base": {
          "type": "string",
          "description": "位域容器段名；不写则相对帧起点"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "位偏移（位，不是字节）"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "order": {
          "type": "string",
          "enum": [
            "lsb0",
            "msb0"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "in",
            "range",
            "mask"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "element",
            "frame"
          ],
          "default": "element"
        },
        "value": {
          "description": "常量匹配（数字/字符串/数组）"
        },
        "expr": {
          "$ref": "#/$defs/expr"
        },
        "min": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/expr"
            }
          ]
        },
        "max": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/expr"
            }
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "xor8",
            "sum8",
            "crc8",
            "crc16",
            "crc16_modbus",
            "crc16_x25",
            "crc24q",
            "crc32",
            "crc32c",
            "nmea_xor"
          ],
          "description": "内置算子；nmea_xor 是 xor8 的别名"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "位宽，支持 24/32 等非 8 倍数"
        },
        "poly": {
          "type": "string",
          "description": "覆盖命名算法参数，支持 0x 前缀"
        },
        "init": {
          "type": "string"
        },
        "refin": {
          "type": "boolean"
        },
        "refout": {
          "type": "boolean"
        },
        "xorout": {
          "type": "string"
        },
        "inject": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "CRC 计算末尾追加的常量字节（如 MAVLink CRC_EXTRA）"
        },
        "code": {
          "type": "string",
          "description": "脚本摘要（alg 二选一）：ctx.data/ctx.len/ctx.fields"
        },
        "from": {
          "type": "string",
          "description": "区间起点：after:<seg> 或 frame_start"
        },
        "to": {
          "type": "string",
          "description": "区间终点：before:<seg> 或 frame_end"
        }
      }
    },
    "length": {
      "type": "object",
      "description": "长度段反算绑定：本段值必须等于后面字段合计的字节/元素数",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit": {
          "type": "string",
          "enum": [
            "bytes",
            "elements"
          ],
          "default": "elements"
        },
        "expr": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "oneOf": [
            {
              "$ref": "#/$defs/typeName"
            },
            {
              "type": "string",
              "pattern": "^@"
            }
          ]
        },
        "count": {
          "description": "元素个数（数组长度）；标量省略默认 1。字节数由 type 推算，不写",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/expr"
            }
          ]
        },
        "length": {
          "$ref": "#/$defs/length"
        },
        "endian": {
          "type": "string",
          "enum": [
            "little",
            "big",
            "le",
            "be"
          ]
        },
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "emit": {
          "type": "string",
          "enum": [
            "channel",
            "aux",
            "none"
          ],
          "default": "channel"
        },
        "expect": {
          "description": "常量匹配（原 v1 value）"
        },

        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "bit": {
          "$ref": "#/$defs/bit"
        },
        "if": {
          "$ref": "#/$defs/expr",
          "description": "条件字段，false 时整段跳过"
        },
        "enum": {
          "type": "object",
          "description": "值 → 名字映射",
          "additionalProperties": {
            "type": "string"
          }
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "repeat": {
          "description": "重复方式：字符串 elems/eos/until，或对象 {mode,until}",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "elems",
                "eos",
                "until"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "eos",
                    "until"
                  ]
                },
                "until": {
                  "$ref": "#/$defs/expr"
                }
              },
              "required": [
                "mode"
              ]
            }
          ]
        },
        "until": {
          "$ref": "#/$defs/expr",
          "description": "repeat:\"until\" 的终止表达式（与对象写法等价）"
        },
        "derive": {
          "type": "string",
          "description": "派生字段表达式（引用前序段名），不读数据、不占字节，输出 f64"
        },
        "transform": {
          "type": "array",
          "description": "值算子链，解析后按序应用",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "sexagesimal",
                  "abs",
                  "round"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": [
                      "sexagesimal",
                      "scale",
                      "mul",
                      "offset",
                      "add",
                      "abs",
                      "round",
                      "clamp"
                    ]
                  },
                  "split": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "k": {
                    "type": "number"
                  },
                  "b": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": [
                  "op"
                ]
              }
            ]
          }
        },
        "empty": {
          "type": "string",
          "enum": [
            "nan",
            "skip",
            "raw"
          ],
          "description": "空字段策略"
        },
        "description": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^=,]+$",
          "description": "key=value 词法：段的键名，值取到 , ; 空白 或记录尾"
        },
        "literal": {
          "type": "string",
          "minLength": 1,
          "description": "必须逐字符匹配的字面量段（$ * , 等）；段级边界，不存在协议级 bin/text"
        },
        "delimiter": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ],
          "description": "该段结束边界；\"blank\" = 空格/Tab 字符类"
        },
        "repeater": {
          "type": "string",
          "enum": [
            "*"
          ],
          "description": "重复到下一段边界（右边界=后一个 literal 或记录尾）"
        },
        "rest": {
          "type": "boolean",
          "description": "整段剩余原文，不切分"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "定宽字符数（fixed 词法）"
        },
        "base": {
          "type": "integer",
          "enum": [
            2,
            8,
            10,
            16
          ],
          "default": 10,
          "description": "数字进制，默认 10"
        },
        "fixed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18,
          "description": "定点小数位数"
        },
        "signed": {
          "type": "boolean",
          "description": "允许负号（默认拒绝）"
        },
        "sci": {
          "type": "boolean",
          "description": "允许科学计数法（默认拒绝）"
        },
        "as": {
          "type": "string",
          "enum": [
            "f64",
            "f32",
            "i64",
            "i32",
            "u64",
            "u32"
          ],
          "description": "数值解释覆盖类型"
        },
        "pattern": {
          "type": "string",
          "description": "正则只做校验，不切分"
        },
        "on_mismatch": {
          "type": "string",
          "enum": [
            "reject",
            "warn",
            "skip"
          ],
          "default": "reject"
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "sexagesimal"
                ]
              },
              "split": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              }
            },
            "required": [
              "op"
            ]
          },
          "description": "值变换；sexagesimal = DDMM.MMM → 十进制度"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "items": {}
        },
        "name": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        },
        "segments": {
          "$ref": "#/$defs/segmentArray"
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/$defs/expr"
        },
        "payload": {
          "type": "string"
        },
        "fallback": {
          "type": "string",
          "enum": [
            "reject",
            "unknown"
          ],
          "default": "reject"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expr": {
          "$ref": "#/$defs/expr"
        },
        "unit": {
          "type": "string",
          "enum": [
            "s",
            "ms",
            "us",
            "ns"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "first_frame",
            "absolute"
          ]
        },
        "raw": {
          "type": "boolean",
          "description": "用原始值而非物理换算值"
        },
        "fallback": {
          "type": "string",
          "enum": [
            "reject",
            "index"
          ]
        }
      }
    }
  }
}
