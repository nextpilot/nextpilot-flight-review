{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotscope.local/schema/psproto-3.json",
  "title": "psproto v3 帧协议模板",
  "description": "顺序字节流 → 帧 → 字段的描述语言。规范见 SPEC.md；本文件只做结构层校验（键、类型、枚举、必填），语义校验由 C++ validate() 承担。v3 不做旧格式兼容：未知键即错误。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "mode",
    "segments"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["bin", "text"],
      "description": "处理形态：bin 按字节解释；text 按字符串切 token 再解析。必填，不设 mixed"
    },
    "description": {
      "type": "string"
    },
    "layout": {
      "type": "string",
      "enum": [
        "sequential"
      ],
      "default": "sequential"
    },
    "endian": {
      "type": "string",
      "enum": [
        "little",
        "big",
        "le",
        "be"
      ],
      "default": "little"
    },
    "maxsize": {
      "type": "integer",
      "minimum": 2,
      "maximum": 65535,
      "default": 4096
    },
    "terminator": {
      "type": "string",
      "description": "text 帧终止标记（可选）"
    },
    "segments": {
      "$ref": "#/$defs/segmentArray"
    },
    "blocks": {
      "type": "object",
      "description": "结构定义：块名 → 字段表。被段以 type 引用，展开成二级行。不写 of 为顺序块；写 of 为位域块",
      "additionalProperties": {
        "$ref": "#/$defs/block"
      }
    },
    "derived": {
      "type": "array",
      "description": "派生量：不读数据、不占字节，按数组顺序求值，可引用前序派生与段输出值",
      "items": {
        "$ref": "#/$defs/derived"
      }
    },
    "series": {
      "$ref": "#/$defs/series"
    },
    "types": {
      "type": "object",
      "description": "类型别名：别名 → 复用的 type/unit/transform/expect",
      "additionalProperties": {
        "$ref": "#/$defs/typeAlias"
      }
    },
    "timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "term": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "帧尾候选集；写了就硬校验，没写就不检查"
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "合法标识符：字母/下划线开头，后续字母数字下划线"
    },
    "typeName": {
      "type": "string",
      "enum": [
        "bit",
        "u8",
        "i8",
        "u16",
        "i16",
        "u32",
        "i32",
        "u64",
        "i64",
        "f32",
        "f64",
        "bool",
        "bcd",
        "char",
        "string",
        "str",
        "number",
        "num",
        "rest",
        "time"
      ],
      "description": "内置类型。bit 表示按位取值，宽度与起始位写在 count 的 wide@off 形式"
    },
    "expr": {
      "type": "string",
      "minLength": 1,
      "description": "数学表达式，可引用其它段的输出值；self 指本段原始值"
    },
    "count": {
      "description": "元素个数。整数 = 恰好 N 个；字符串 = 变量名、表达式、*、或 bit 类型的 \"宽@起始位\"",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "segmentArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "segment": {
      "description": "段：bin 段（10 键）或 text 段（保留词法键）。oneOf 保证互不串键",
      "oneOf": [
        {
          "$ref": "#/$defs/segmentBin"
        },
        {
          "$ref": "#/$defs/segmentText"
        }
      ]
    },
    "expectItem": {
      "type": "object",
      "description": "一条约束。多位数组之间是 AND 关系；判定对象是段的原始值，不是变换后的输出值",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "in",
            "mask",
            "xor8",
            "sum8",
            "crc8",
            "crc16",
            "crc16_modbus",
            "crc16_x25",
            "crc24q",
            "crc32",
            "crc32c",
            "nmea_xor",
            "parity",
            "script"
          ],
          "description": "比较类 eq/ne/lt/le/gt/ge/in/mask；序列类 xor8…parity；script 走脚本摘要"
        },
        "value": {
          "description": "比较常量：数字或字符串；mask 时为比对目标值",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "expr": {
          "$ref": "#/$defs/expr"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "description": "in 的候选集合",
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "labels": {
          "type": "object",
          "description": "枚举名字表：值 → 显示名，仅 in 使用",
          "additionalProperties": {
            "type": "string"
          }
        },
        "mask": {
          "type": "integer",
          "minimum": 1,
          "description": "mask 的位掩码；判定 (raw & mask) == value"
        },
        "over": {
          "type": "string",
          "description": "序列类覆盖区间：start:end、after:<seg>、frame_start:frame_end、before:<seg>"
        },
        "poly": {
          "type": "string",
          "description": "多项式，支持 0x 前缀"
        },
        "init": {
          "type": "string"
        },
        "refin": {
          "type": "boolean"
        },
        "refout": {
          "type": "boolean"
        },
        "xorout": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "序列结果位宽，支持 24 等非 8 倍数"
        },
        "inject": {
          "type": "array",
          "description": "计算末尾追加的常量字节（如 MAVLink CRC_EXTRA）",
          "items": {
            "type": "integer"
          }
        },
        "code": {
          "type": "string",
          "description": "script 摘要：ctx.data / ctx.len / ctx.fields"
        }
      }
    },
    "transformStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "sexagesimal",
            "scale",
            "mul",
            "offset",
            "add",
            "abs",
            "round",
            "clamp",
            "sin",
            "cos",
            "tan",
            "sqrt",
            "log",
            "exp"
          ]
        },
        "split": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "k": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "transform": {
      "description": "值变换：单条数学表达式（self 为本段原始值），或算子链数组。只影响输出值，不参与约束判定",
      "oneOf": [
        {
          "$ref": "#/$defs/expr"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transformStep"
          }
        }
      ]
    },
    "output": {
      "type": "string",
      "enum": [
        "channel",
        "aux",
        "none"
      ],
      "default": "channel",
      "description": "输出方式：channel 进图通道；aux 辅助值；none 不输出"
    },
    "onMismatch": {
      "type": "string",
      "enum": [
        "reject",
        "warn",
        "skip"
      ],
      "default": "reject"
    },
    "expectArray": {
      "type": "array",
      "description": "约束数组，逐项 AND；空数组等价于不约束",
      "items": {
        "$ref": "#/$defs/expectItem"
      }
    },
    "segmentBin": {
      "type": "object",
      "additionalProperties": false,
      "description": "bin 段：name / description / unit / output / type / count / transform / expect / on_mismatch / if",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/ident"
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "type": {
          "description": "内置类型名、bit，或 blocks 里的块名",
          "anyOf": [
            {
              "$ref": "#/$defs/typeName"
            },
            {
              "$ref": "#/$defs/ident"
            }
          ]
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "expect": {
          "$ref": "#/$defs/expectArray"
        },
        "on_mismatch": {
          "$ref": "#/$defs/onMismatch"
        },
        "if": {
          "$ref": "#/$defs/expr",
          "description": "条件段，表达式为假时整段跳过、不占字节"
        }
      }
    },
    "segmentText": {
      "type": "object",
      "additionalProperties": false,
      "description": "text 段：在 bin 段基础上保留词法切分键（key/literal/delimiter/width/base/fixed/signed/sci/pattern/empty/rest/repeater）",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/ident"
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "expect": {
          "$ref": "#/$defs/expectArray"
        },
        "on_mismatch": {
          "$ref": "#/$defs/onMismatch"
        },
        "if": {
          "$ref": "#/$defs/expr"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^=,]+$",
          "description": "key=value 词法：段的键名，值取到 , ; 空白 或记录尾"
        },
        "literal": {
          "type": "string",
          "minLength": 1,
          "description": "必须逐字符匹配的字面量段"
        },
        "delimiter": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ],
          "description": "该段结束边界；\"blank\" = 空格/Tab 字符类"
        },
        "repeater": {
          "type": "string",
          "enum": [
            "*"
          ],
          "description": "重复到下一段边界（右边界=后一个 literal 或记录尾）"
        },
        "rest": {
          "type": "boolean",
          "description": "整段剩余原文，不切分"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "定宽字符数（fixed 词法）"
        },
        "base": {
          "type": "integer",
          "enum": [
            2,
            8,
            10,
            16
          ],
          "default": 10
        },
        "fixed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18,
          "description": "定点小数位数"
        },
        "signed": {
          "type": "boolean",
          "description": "允许负号（默认拒绝）"
        },
        "sci": {
          "type": "boolean",
          "description": "允许科学计数法（默认拒绝）"
        },
        "pattern": {
          "type": "string",
          "description": "正则只做校验，不切分"
        },
        "empty": {
          "type": "string",
          "enum": [
            "nan",
            "skip",
            "raw"
          ],
          "description": "空字段策略"
        }
      }
    },
    "typeAlias": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "unit": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "expect": {
          "$ref": "#/$defs/expectArray"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "of": {
          "$ref": "#/$defs/typeName",
          "description": "位域块的容器类型（如 u32）；不写为顺序块。位域块只读一个容器值，子字段按 wide@off 切位"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "description": "块内字段表；不再嵌套块",
          "items": {
            "$ref": "#/$defs/segmentBin"
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expr"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/ident"
        },
        "expr": {
          "$ref": "#/$defs/expr"
        },
        "unit": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "items": {}
        },
        "name": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        },
        "segments": {
          "$ref": "#/$defs/segmentArray"
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/$defs/expr"
        },
        "payload": {
          "type": "string"
        },
        "fallback": {
          "type": "string",
          "enum": [
            "reject",
            "unknown"
          ],
          "default": "reject"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expr": {
          "$ref": "#/$defs/expr"
        },
        "unit": {
          "type": "string",
          "enum": [
            "s",
            "ms",
            "us",
            "ns"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "first_frame",
            "absolute"
          ]
        },
        "raw": {
          "type": "boolean",
          "description": "用原始值而非物理换算值"
        },
        "fallback": {
          "type": "string",
          "enum": [
            "reject",
            "index"
          ]
        }
      }
    }
  }
}
