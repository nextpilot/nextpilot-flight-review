<RCC>
  <!-- ng 的图标资源：外壳（ShellBinder）把动作的 icon 字段解析成这里的 QIcon。 -->
  <qresource prefix="/icons">
    <file alias="plot_refresh.svg">icons/plot_refresh.svg</file>
    <file alias="data_table.svg">icons/data_table.svg</file>
    <file alias="view_panel.svg">icons/view_panel.svg</file>
    <file alias="file_open.svg">icons/file_open.svg</file>
    <file alias="record.svg">icons/record.svg</file>
    <file alias="theme_toggle.svg">icons/theme_toggle.svg</file>
    <file alias="search.svg">icons/search.svg</file>
    <file alias="settings.svg">icons/settings.svg</file>
    <file alias="trash.svg">icons/trash.svg</file>
    <file alias="box.svg">icons/box.svg</file>
    <file alias="hand.svg">icons/hand.svg</file>
    <file alias="play.svg">icons/play.svg</file>
    <file alias="pause.svg">icons/pause.svg</file>
    <file alias="loop.svg">icons/loop.svg</file>
    <file alias="replay.svg">icons/replay.svg</file>
    <file alias="step_fwd.svg">icons/step_fwd.svg</file>
  </qresource>
</RCC>
