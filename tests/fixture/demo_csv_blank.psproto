{
  "name": "demo_csv_blank",
  "mode": "text",
  "description": "无同步字的空白分隔文本（CSV 变体）：靠 term 分帧，blank 作为协议级分隔符类",
  "layout": "sequential",
  "maxsize": 128,
  "segments": [
    {
      "name": "id",
      "type": "number",
      "delimiter": "blank"
    },
    {
      "name": "val",
      "type": "number",
      "delimiter": "blank"
    },
    {
      "name": "name",
      "type": "string",
      "delimiter": "blank"
    }
  ],
  "term": [
    "\r\n",
    "\n"
  ]
}
