{
  "name": "demo_csv_blank",
  "description": "无同步字的空白分隔文本（CSV 变体）：靠 term 分帧，blank 作为协议级分隔符类",
  "layout": "sequential",
  "lexer": "delimited",
  "maxsize": 128,
  "term": ["\r\n", "\n"],
  "segments": [
    { "name": "id", "type": "number", "delimiter": "blank" },
    { "name": "val", "type": "number", "delimiter": "blank" },
    { "name": "name", "type": "string", "delimiter": "blank" }
  ]
}
