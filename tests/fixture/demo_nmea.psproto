{
  "name": "demo_nmea",
  "description": "NMEA 字符串 msgid 系列选择",
  "layout": "sequential",
  "endian": "little",
  "maxsize": 64,
  "segments": [
    {
      "name": "dollar",
      "count": 1,
      "type": "u8",
      "role": "sync",
      "expect": 36,
      "emit": "none"
    },
    {
      "name": "msgid",
      "count": 5,
      "type": "text"
    },
    {
      "name": "comma",
      "count": 1,
      "type": "u8",
      "expect": 44,
      "emit": "none"
    },
    {
      "name": "payload",
      "count": 4,
      "type": "u8",
      "role": "payload"
    }
  ],
  "series": {
    "selector": "msgid",
    "payload": "payload",
    "fallback": "reject",
    "variants": [
      {
        "value": "GPGGA",
        "name": "gga",
        "segments": [
          {
            "name": "alt",
            "count": 1,
            "type": "u16",
            "scale": 0.1,
            "unit": "m"
          },
          {
            "name": "hdop",
            "count": 1,
            "type": "u16",
            "scale": 0.1
          }
        ]
      },
      {
        "value": "GPRMC",
        "name": "rmc",
        "segments": [
          {
            "name": "speed",
            "count": 1,
            "type": "u16",
            "scale": 0.1,
            "unit": "kn"
          },
          {
            "name": "course",
            "count": 1,
            "type": "u16",
            "scale": 0.1,
            "unit": "deg"
          }
        ]
      }
    ]
  }
}
