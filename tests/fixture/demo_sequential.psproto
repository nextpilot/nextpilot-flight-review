{
  "name": "demo_seq",
  "description": "顺序段、元素个数、CRC 区间、timestamp、系列协议",
  "layout": "sequential",
  "endian": "little",
  "maxsize": 64,
  "timestamp": {
    "expr": "time_s",
    "unit": "s",
    "origin": "first_frame"
  },
  "segments": [
    {
      "name": "sync1",
      "count": 1,
      "type": "u8",
      "expect": 170,
      "emit": "none"
    },
    {
      "name": "sync2",
      "count": 1,
      "type": "u8",
      "expect": 85,
      "emit": "none"
    },
    {
      "name": "seq",
      "count": 1,
      "type": "u8"
    },
    {
      "name": "msgid",
      "count": 1,
      "type": "u16"
    },
    {
      "name": "length",
      "count": 1,
      "type": "u16",
      "emit": "none",
      "length": {
        "fields": [
          "payload"
        ],
        "unit": "bytes"
      }
    },
    {
      "name": "time_s",
      "count": 1,
      "type": "u32"
    },
    {
      "name": "payload",
      "count": "length",
      "type": "u8"
    },
    {
      "name": "crc",
      "count": 1,
      "type": "u8",
      "emit": "none",
      "checks": [
        {
          "op": "crc8",
          "over": [
            "sync1:payload"
          ]
        }
      ]
    }
  ],
  "series": {
    "selector": "msgid",
    "payload": "payload",
    "fallback": "reject",
    "variants": [
      {
        "value": 1,
        "name": "att",
        "segments": [
          {
            "name": "roll",
            "count": 1,
            "type": "i16",
            "scale": 0.01,
            "unit": "rad"
          },
          {
            "name": "pitch",
            "count": 1,
            "type": "i16",
            "scale": 0.01,
            "unit": "rad"
          }
        ]
      },
      {
        "values": [
          2,
          3
        ],
        "name": "env",
        "segments": [
          {
            "name": "temp",
            "count": 1,
            "type": "i16",
            "scale": 0.1,
            "unit": "C"
          }
        ]
      }
    ]
  }
}
