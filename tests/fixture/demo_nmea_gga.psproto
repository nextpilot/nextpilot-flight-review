{
  "name": "demo_nmea_gga",
  "mode": "text",
  "description": "NMEA GGA 流式解析：$ 定位、* 硬匹配、XOR 校验、\r\n 帧尾；与二进制共用同一套段模型",
  "layout": "sequential",
  "maxsize": 128,
  "segments": [
    {
      "name": "dollar",
      "output": "none",
      "format": "$"
    },
    {
      "name": "msgid",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "utc",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "lat",
      "format": "%f",
      "unit": "deg",
      "transform": [
        {
          "op": "sexagesimal",
          "split": 3
        }
      ]
    },
    {
      "name": "ns",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "lon",
      "format": "%f",
      "unit": "deg",
      "transform": [
        {
          "op": "sexagesimal",
          "split": 3
        }
      ]
    },
    {
      "name": "ew",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "fix",
      "format": "%d",
      "output": "none"
    },
    {
      "name": "sats",
      "format": "%d",
      "output": "none"
    },
    {
      "name": "hdop",
      "format": "%f",
      "output": "none"
    },
    {
      "name": "alt",
      "format": "%f",
      "unit": "m"
    },
    {
      "name": "alt_unit",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "geoid",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "geoid_unit",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "age",
      "format": "%f",
      "output": "none"
    },
    {
      "name": "station",
      "format": "%s",
      "output": "none"
    },
    {
      "name": "star",
      "output": "none",
      "format": "*"
    },
    {
      "name": "check",
      "output": "aux",
      "format": "%x",
      "expect": [
        {
          "op": "xor8",
          "over": "dollar:star"
        }
      ]
    }
  ],
  "term": [
    "\r\n"
  ]
}