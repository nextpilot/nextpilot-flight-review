{
  "id": "plotscope.helloworld",
  "version": "0.1.0",
  "builtin": true,
  "activationEvents": ["onCommand:hello.say"],
  "contributes": {
    "commands": [
      { "command": "hello.say", "title": "说你好", "category": "测试", "icon": "chat", "order": 10 }
    ],
    "menus": {
      "commandPalette": [
        { "command": "hello.say", "group": "z@1" }
      ],
      "editor/context": [
        { "command": "hello.say", "group": "z@2", "when": "editor" }
      ],
      "view/title": [
        { "command": "hello.say", "group": "navigation", "when": "view == hello.view" }
      ],
      "view/item/context": [
        { "command": "hello.say", "group": "inline", "when": "view == hello.view && item.kind == demo" }
      ],
      "statusbar": [
        { "command": "hello.say", "group": "z@3" }
      ]
    },
    "viewsContainers": [
      { "id": "hello.container", "title": "示例视图", "area": "sidebar", "icon": "chat", "order": 20 }
    ],
    "views": [
      { "id": "hello.view", "name": "示例", "container": "hello.container", "icon": "hello.icon", "order": 0 },
      { "id": "hello.view.plain", "name": "无图标示例", "container": "hello.container", "order": 1 }
    ],
    "colors": {
      "hello.accent": { "dark": "#4fc3f7", "light": "#0277bd" }
    },
    "customEditors": [
      {
        "viewType": "hello.web",
        "displayName": "网页视图",
        "priority": 10,
        "selector": [{ "mime": "text/html" }]
      }
    ],
    "configuration": [
      {
        "title": "示例设置",
        "iconId": "chat",
        "order": 40,
        "properties": {
          "hello.greeting": { "type": "string", "default": "你好", "description": "问候语", "order": 1 },
          "hello.count": { "type": "number", "default": 3, "minimum": 1, "maximum": 10, "order": 2 },
          "hello.verbose": { "type": "boolean", "default": false, "order": 3 }
        }
      }
    ],
    "statusbar": [
      { "id": "hello.status", "side": "right", "priority": 30, "tooltip": "示例状态", "text": "示例: --", "commandId": "hello.say" }
    ]
  }
}
