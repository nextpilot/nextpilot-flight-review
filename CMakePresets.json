{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC 2022 x64 (Qt 6.12.0 msvc2022_64)",
      "description": "Visual Studio 17 2022 + Qt 6.12.0 msvc2022_64，多配置生成器",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "D:/program/Qt/6.12.0/msvc2022_64"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64 Debug（deps/ Qt 6.2.4 + GCC）",
      "description": "云主机：qtbase/qtsvg/qttools/icu 与 Lua 5.4.4 固定在仓库 deps/（不进 git，容器快照回滚不影响），系统提供 zlib/zstd/lz4，cargo 在 ~/.cargo/bin。先跑 tools/bootstrap-deps.sh",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "${sourceDir}/deps/Qt/6.2.4/gcc_64",
        "LUA_LIBRARY": "${sourceDir}/deps/lua/lib/liblua.a",
        "LUA_INCLUDE_DIR": "${sourceDir}/deps/lua/include"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64 Release（deps/ Qt 6.2.4 + GCC）",
      "description": "与 linux 同环境，CMAKE_BUILD_TYPE=Release，产物在 build-release/，避免和 Debug 共用一次配置",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/deps/Qt/6.2.4/gcc_64",
        "LUA_LIBRARY": "${sourceDir}/deps/lua/lib/liblua.a",
        "LUA_INCLUDE_DIR": "${sourceDir}/deps/lua/include"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC 2022 Debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC 2022 Release",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug（-j2）",
      "configurePreset": "linux",
      "jobs": 2,
      "environment": {
        "PATH": "$penv{HOME}/.cargo/bin:$penv{PATH}"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release（-j2）",
      "configurePreset": "linux-release",
      "jobs": 2,
      "environment": {
        "PATH": "$penv{HOME}/.cargo/bin:$penv{PATH}"
      }
    }
  ],
  "testPresets": [
    {
      "name": "linux",
      "displayName": "Linux ctest（offscreen）",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "PATH": "$penv{HOME}/.cargo/bin:$penv{PATH}"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux ctest Release（offscreen）",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "PATH": "$penv{HOME}/.cargo/bin:$penv{PATH}"
      }
    }
  ]
}
